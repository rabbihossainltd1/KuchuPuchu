rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid);
      allow delete: if false;
      match /{sub=**} {
        allow read, write: if isMe(uid);
      }
    }

    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
      allow update: if signedIn();
      match /likes/{uid} {
        allow read, write: if isMe(uid);
      }
      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    match /stories/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /storyViews/{id} {
      allow read, write: if signedIn();
    }

    match /friendships/{id} {
      allow read, write: if signedIn();
    }

    match /conversations/{id} {
      allow read, write: if signedIn() && request.auth.uid in resource.data.members
        || signedIn() && request.auth.uid in request.resource.data.members;
      match /messages/{mid} {
        allow read, write: if signedIn();
      }
    }

    match /notifications/{id} {
      allow read, create, update: if signedIn();
    }

    match /duoRequests/{id} {
      allow read, write: if signedIn();
    }

    match /calls/{id} {
      allow read, write: if signedIn();
      match /ice/{iid} {
        allow read, write: if signedIn();
      }
    }

    match /follows/{id} {
      allow read, write: if signedIn();
    }
    match /blocks/{id} {
      allow read, write: if signedIn();
    }
    match /reports/{id} {
      allow create: if signedIn();
      allow read: if false;
    }
  }
}

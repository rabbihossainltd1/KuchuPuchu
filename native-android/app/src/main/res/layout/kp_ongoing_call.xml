<?xml version="1.0" encoding="utf-8"?>
<!-- Owner round 13 (2026-09-05): the in-call notification in the app's own
     style — dark-blue card, app-styled speaker toggle (voice only) and a
     BIG red End button. Video calls show End only (owner rule). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kp_ongoing_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="#16213A">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/kp_ongoing_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#E9EDF6"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kp_ongoing_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#8A97B2"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Owner round 16: compact, background-FREE action buttons — plain
         icons, no circles, same for voice and video. -->
    <FrameLayout
        android:id="@+id/kp_ongoing_speaker_wrap"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="10dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center"
            android:src="@drawable/kp_ic_speaker"
            android:contentDescription="@null" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/kp_ongoing_end"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/kp_ic_call_end"
            android:contentDescription="@null" />
    </FrameLayout>
</LinearLayout>

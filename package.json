{
  "name": "kuchupuchu",
  "version": "3.0.0",
  "private": true,
  "description": "KuchuPuchu — Cloudflare Worker API + native Android client",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "build:web:prod": "VITE_KP_WEB_ACCOUNT_INTEGRATION=true VITE_KP_WEB_MESSAGING=true VITE_KP_WEB_STATUSES=true npm run build:web",
    "verify:web-sw": "tsx scripts/verify-web-sw.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "tsx test/run.ts",
    "test:web:e2e": "playwright test --config playwright.config.ts",
    "test:web:account:e2e": "playwright test --config playwright.account.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:secrets": "tsx scripts/secret-scan.ts",
    "security:deps": "npm audit --omit=dev --audit-level=critical",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "ci": "npm run format:check && npm run typecheck && npm run typecheck:web && npm run check:web-stickers && npm run build:web && npm run verify:web-sw && npm run test && npm run test:web:e2e && npm run test:web:account:e2e && npm run test:web:messaging:e2e && npm run test:web:status:e2e && npm run test:web:calls:e2e && npm run test:web:push:e2e && npm run test:web:hardening:e2e && npm run test:web:cutover:e2e && npm run build:web:prod && npm run verify:web-sw && npm run security:secrets && npm run validate:android",
    "validate:android": "tsx scripts/validate-android.ts",
    "test:web:messaging:e2e": "playwright test --config playwright.messaging.config.ts",
    "test:web:status:e2e": "playwright test --config playwright.status.config.ts",
    "generate:web-stickers": "tsx scripts/generate-web-stickers.ts",
    "check:web-stickers": "tsx scripts/generate-web-stickers.ts --check",
    "test:web:calls:e2e": "playwright test --config playwright.calls.config.ts",
    "test:web:push:e2e": "playwright test --config playwright.push.config.ts",
    "test:web:hardening:e2e": "playwright test --config playwright.hardening.config.ts",
    "test:web:cutover:e2e": "playwright test --config playwright.cutover.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "better-sqlite3": "^12.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "8.3.2",
    "wrangler": "^4.33.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}

NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:4000
# Android/web client talks here. Leave empty for same-origin (browser).
# Example: https://api.your-domain.com
VITE_API_BASE=
DATABASE_URL=file:./dev.db
SESSION_SECRET=replace-with-64-plus-random-characters
COOKIE_SECURE=false

# Optional Google OAuth. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP. If unset, verification emails are written to the development mailbox only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KuchuPuchu <no-reply@localhost>

# First admin account, created only when no admin exists.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-this-admin-password
ADMIN_BOOTSTRAP_NAME=Super Admin

# SPV payment. Use sandbox without live credentials.
# live | sandbox
SPV_MODE=sandbox
SPV_API_KEY=
SPV_API_BASE=https://spv-payment-api.pages.dev/api/v1
SPV_INTEGRATION_ORIGIN=
SPV_WEBHOOK_SECRET=

# Optional Sentry-style DSN later; unused if empty.
LOG_LEVEL=info
